{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ansible-lint *)",
      "Bash(ansible-playbook --syntax-check *)",
      "Bash(ansible-playbook -C *)",
      "Bash(molecule *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git stash *)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
