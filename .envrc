#!/bin/sh
layout_uv() {
  if [ -d ".venv" ]; then
    VIRTUAL_ENV="$(pwd)/.venv"
  fi

  if [ -z "$VIRTUAL_ENV" ] || [ ! -d "$VIRTUAL_ENV" ]; then
    if [ ! -f "pyproject.toml" ]; then
      log_status "No uv project exists. Executing \`uv init\` to create one."
      uv init --no-readme
      rm main.py
      uv venv
    else
      uv sync
    fi
    VIRTUAL_ENV="$(pwd)/.venv"
  fi

  if [ -d ".venv/bin" ]; then
    PATH_add .venv/bin
  elif [ -d ".venv/Scripts" ]; then
    PATH_add .venv/Scripts
  fi
  export UV_ACTIVE=1 # or VENV_ACTIVE=1
  export VIRTUAL_ENV
}
layout uv

if [ "$(uname -s)" = "Darwin" ] && [ "$(uname -m)" = "arm64" ]; then
  export DISABLE_SLURM_JOB_CONTAINER="true"
  export VAGRANT_PROVIDER="virtualbox"
  export VAGRANT_ALMA10_BOX="bento/almalinux-10.1"
  export VAGRANT_ALMA9_BOX="bento/almalinux-9.7"
else
  unset DISABLE_SLURM_JOB_CONTAINER
  unset VAGRANT_PROVIDER
  unset VAGRANT_ALMA10_BOX
  unset VAGRANT_ALMA9_BOX
fi
. ansible.env
